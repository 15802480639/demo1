# ============================================================
# WebShopp 环境变量模板
# 用法：复制为 .env 并填入真实值  ->  copy env.example .env
# ============================================================

# ===== 必填 =====

# Postgres 数据库连接串
# 推荐 Supabase 免费库：https://supabase.com -> Project -> Settings -> Database -> Connection string (URI)
# 注意密码里的特殊字符需做 URL 编码（如 @ -> %40）
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.supabase.co:5432/postgres?sslmode=require

# 会话签名密钥（生产环境必须改！至少 32 位随机串）
# 可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-hex-string-at-least-32-chars

# 站点公开地址（用于邮件链接、SEO；端口与下方 next start 端口一致，默认 3000）
NEXT_PUBLIC_SITE_URL=http://你的公网IP:3000

# ===== 可选：邮件通知（不填则下单/注册不发邮件，不影响网站运行） =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM=shop@webshopp.kr

# ===== 数据库 =====
# 本地可用: postgresql://postgres:postgres@localhost:5432/webshopp?schema=public
# 云推荐: Supabase / Neon (海外低延迟)
DATABASE_URL="postgresql://user:password@localhost:5432/webshopp?schema=public"

# ===== 站点 =====
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ===== 支付 (Stripe, 海外为主) =====
# TODO(待用户): 填入 Stripe 测试/生产 Key
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ===== 会话 / 鉴权 =====
# 任意随机长字符串: openssl rand -base64 32
AUTH_SECRET=""

# ===== 邮件（电子报群发 / 订单通知）=====
# ⚠️ 两者都不填 = **演练模式**：邮件内容只写服务器日志，不真实投递。
#    后台「订阅列表」页面顶部会显示黄色提示条，不会让人误以为已发出。
#
# 开通步骤（Resend，免费额度 3000 封/月，国内可直连）：
#   1. https://resend.com 注册
#   2. Add Domain 填你的发信域名（如 newsletter.yourdomain.com）
#   3. 按提示在 DNS 加 SPF / DKIM 记录（不加的话邮件大概率进垃圾箱）
#   4. 复制 API Key 填到下面，重启服务即生效
RESEND_API_KEY=""

# 发信人地址，**必须是上面已验证域名下的地址**（Resend 会强校验）
MAIL_FROM="J&D <newsletter@yourdomain.com>"

# 如需改用 SMTP（阿里云邮件推送 / Naver SMTP 等），填下面四项即可优先走 SMTP
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASS=""

# ===== 阿里云 OSS（图片存储）=====
# 推荐方式：ECS RAM Role —— 服务器不保存任何长期 AccessKey，
# 凭证从实例元数据服务自动获取并轮换（默认 6 小时）。
#   1. RAM 控制台创建角色（如 JNDOSSImageRole），受信服务选「ECS」
#   2. 附加只授权目标 Bucket 读写的自定义策略
#   3. 把角色绑定到 ECS 实例
#   4. 下面四项填好即可，AccessKey 留空
OSS_BUCKET="jd-oss"
OSS_REGION="oss-cn-hongkong"
OSS_ROLE_NAME="JNDOSSImageRole"
# 公网访问前缀，留空则自动拼 https://{bucket}.{region}.aliyuncs.com
OSS_PUBLIC_URL=""

# 备用：静态 AccessKey（不推荐，会长期留在服务器上）
# 仅在无法使用 RAM Role 时填，三者需同时提供
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_STS_TOKEN=""

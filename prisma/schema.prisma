// Prisma 数据模型 —— 全功能电商
// Prisma 7 范式：url 已移出 schema（见 prisma.config.ts），client 用 adapter 连接
// 生成: npx prisma generate   迁移: npx prisma migrate dev
// 数据库: PostgreSQL（海外部署标准，本地可用 Supabase / Neon / 本机 PG）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------- 用户与地址 ----------------
model User {
  id            String         @id @default(cuid())
  username      String?        @unique // 登录账号（注册时必填，老用户为空则用邮箱登录）
  email         String?        @unique // 选填
  name          String?
  passwordHash  String?
  role          String         @default("customer") // customer | admin
  /// 积分余额（可抵扣现金的虚拟权益）。所有增减必须经 PointTransaction 留痕，禁止直接改。
  points        Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  cart          Cart?
  consultations Consultation[]
  chatConversations ChatConversation[]
  pointTxns     PointTransaction[]
  userCoupons   UserCoupon[]
  /// 本人专属邀请码（注册时自动生成，用于推广）。唯一。
  inviteCode   String?   @unique
  /// 上级（邀请人）用户 ID。自引用 1 级关系。
  invitedById  String?
  invitedBy    User?     @relation("UserReferral", fields: [invitedById], references: [id])
  invitedUsers User[]    @relation("UserReferral")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String? // 收件人姓名
  line1      String
  line2      String?
  city       String
  state      String?
  country    String
  postalCode String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  orders     Order[]
}

// ---------------- 商品 / 分类 / 品牌 ----------------
model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  nameZh    String? // 多语言预留
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  imageUrl  String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  nameZh   String? // 中文品牌名
  logoUrl  String?
  products Product[]
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  nameZh         String? // 中文商品名（后台双语录入，zh 前台优先显示）
  description    String?
  descriptionZh  String? // 中文描述
  code           String? // 货号 / style code（如 GF410），列表卡小字展示
  gender         String? // men | women | unisex
  brandId        String?
  brand          Brand?         @relation(fields: [brandId], references: [id])
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  price          Int // 基准价（韩元 ₩，整数）
  currency       String         @default("KRW")
  compareAtPrice Int?
  images         String         @default("[]") // JSON 字符串数组
  tags           String         @default("[]") // JSON 字符串数组：new | sale | overseas
  status         String         @default("draft") // draft | active | archived
  rating         Float          @default(0)
  reviewCount    Int            @default(0)
  featured       Boolean        @default(false)
  // ---- 积分配置（商品级，可覆盖全局规则）----
  /// 该商品是否参与「消费返积分」。false = 买了不返积分
  earnPoints     Boolean        @default(true)
  /// 返积分模式：percent = 按实付金额百分比返；fixed = 按件固定返
  earnType       String         @default("percent") // percent | fixed
  /// percent 时表示百分比整数（如 5 = 5%）；fixed 时表示每件返多少积分
  earnValue      Int            @default(0)
  /// 该商品是否允许用积分抵扣。false = 只能用现金
  usePoints      Boolean        @default(true)
  /// 该商品用积分抵扣时的「最多可抵扣积分上限」。0 = 不单独限制，跟随全局上限
  maxPointUse    Int            @default(0)
  /// 购买该商品赠送的优惠券 ID 列表（JSON 数组）。订单支付成功后自动发到用户账户
  grantCouponIds String         @default("[]")
  skus           Sku[]
  specs          ProductSpec[]
  reviews        Review[]
  wishlist       Wishlist[]
  consultations  Consultation[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([gender])
}

// 商品规格组（可多组：颜色 / 尺码 / 材质…），每组含多个规格值，中韩双语
model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // 规格名（韩语/默认），如 색상 / 사이즈
  nameZh    String? // 规格名（中文），如 颜色 / 尺码
  values    String // JSON: [{"ko":"레드","zh":"红色"}, ...]
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, order])
}

model Sku {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuCode   String   @unique
  options   String? // JSON 字符串：{ "Color": "Red", "Size": "M" }
  price     Int?
  stock     Int      @default(0)
  weight    Float?
  createdAt DateTime @default(now())
}

// ---------------- 购物车 ----------------
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  skuId     String?
  quantity  Int     @default(1)

  @@unique([cartId, productId, skuId])
}

// ---------------- 订单 ----------------
model Order {
  id          String      @id @default(cuid())
  orderNo     String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      String      @default("pending") // pending|paid|fulfilled|shipped|completed|cancelled|refunded
  items       OrderItem[]
  subtotal    Int
  discount    Int         @default(0)
  shippingFee Int         @default(0)
  tax         Int         @default(0)
  /// 本单抵扣掉的现金金额（由积分换算而来，单位韩元）
  pointsDiscount Int      @default(0)
  /// 本单实际消耗的积分数
  pointsUsed     Int      @default(0)
  /// 本单消费后赠送的积分数（退款时按这个数扣回）
  pointsEarned   Int      @default(0)
  /// 积分已结算标记：防止订单反复改状态导致重复发放/重复扣回
  pointsSettled  Boolean  @default(false)
  total       Int
  currency    String      @default("KRW")
  couponCode  String?
  trackingNo  String?
  carrier     String?
  contacted   Boolean     @default(false) // 后台客服是否已联系该订单客户
  contactedAt DateTime?
  addressId   String?
  address     Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shipmentId  String?
  paymentId   String?
  pointTxns   PointTransaction[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  skuId     String?
  name      String
  price     Int
  quantity  Int
  imageUrl  String?
  /// 下单时的规格快照（JSON）：{ "색상": "화이트", "사이즈": "M" }。
  /// 为什么必须存快照：SKU 后续被改库存/改名，历史订单要保留当时买的是哪个色号尺码。
  options   String? // JSON 字符串
  /// 规格可读摘要，如「颜色:白色 / 尺码:M」，后台与前台订单详情直接展示
  skuLabel  String?
  /// 该行实际支付的金额（已按比例分摊优惠券与积分抵扣），用于精确返积分
  paidAmount Int    @default(0)
}

// ---------------- 积分体系 ----------------

/// 积分流水（每笔增减都留痕，用户在「我的积分」页看到的就是这张表）。
///
/// type 取值：
///   earn        消费返积分（正向）
///   use         下单抵扣积分（负向）
///   refund_deduct 订单退款，扣回当初赠送的积分（负向）
///   admin_add   后台手动增加（正向）
///   admin_minus 后台手动扣减（负向）
model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 变动积分数（正=增加，负=扣减）
  amount    Int
  /// 变动类型：earn | use | refund_deduct | admin_add | admin_minus
  type      String
  /// 关联订单（后台手动调整时为空）
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// 备注：后台手动调整原因、返积分说明等
  remark    String?
  /// 变动后的积分余额快照，便于对账
  balanceAfter Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
}

/// 积分规则（全局单例，id 固定为 'global'）。
/// 后台「积分设置」页读写这一行；商品级配置在 Product 上，可覆盖这里的默认值。
model PointRule {
  id String @id @default("global")
  /// 积分系统总开关。关闭后前台不显示积分入口，下单也不再允许抵扣
  enabled        Boolean  @default(true)
  /// 消费返积分：按实付金额的百分比（整数，5 = 5%）
  earnPercent    Int      @default(5)
  /// 使用积分的门槛：订单实付需满多少韩元才允许用积分
  minSpendForUse Int      @default(50000)
  /// 多少积分抵 1 韩元（100 积分 = 1₩，即 1 积分 = 0.01₩）
  pointsPerKrw   Int      @default(100)
  /// 单笔订单最多能抵扣订单金额的百分之多少（防止用户把积分一次性全用光）
  maxUsePercent  Int      @default(30)
  updatedAt      DateTime @updatedAt
}

/// 用户优惠券（券发放到人）。
///
/// 为什么需要：原来 Coupon 不与用户绑定，用户只能在结算页手输券码，
/// 没有任何"我的优惠券"入口。后台发券 → 用户账户页看到券 → 结算页直接选。
model UserCoupon {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  String
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  /// 状态：available（未使用）| used（已使用）| expired（已过期）
  status    String    @default("available")
  /// 使用该券的订单
  usedOrderNo String?
  /// 发放来源：admin（后台发放）| auto（消费返券）| event（活动领取）
  source    String    @default("admin")
  /// 自动发券时记录赠送订单号（退款时按此收回未使用的券；同一订单不会重复发）
  grantedByOrder String?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime?

  @@index([userId, status])
  @@index([couponId])
}

// ---------------- 促销 / 评价 / 物流 ----------------
model Coupon {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  code       String    @unique
  type       String // percent | fixed
  value      Int
  minSpend   Int       @default(0)
  productIds String    @default("[]") // JSON 数组：适用商品 id；空=全场通用
  startsAt   DateTime?
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  userCoupons UserCoupon[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1-5
  title     String?
  content   String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model Shipment {
  id         String    @id @default(cuid())
  orderId    String    @unique
  carrier    String?
  trackingNo String?
  status     String    @default("preparing") // preparing|shipped|delivered
  shippedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ---------------- 收藏 ----------------
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------- 首页轮播图（可后台上传的多图 Banner） ----------------
model EventItem {
  id         String   @id @default(cuid())
  title      String // 标题（韩语，默认语种）
  titleZh    String? // 标题（中文）
  subtitle   String?
  subtitleZh String?
  badge      String? // 角标（如 LIVE / NEW）
  imageUrl   String? // 配图（可选）
  href       String? // 点击跳转
  order      Int      @default(0)
  status     String   @default("published") // published | draft
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, order])
}

model HeroBanner {
  id         String   @id @default(cuid())
  image      String // 图片 URL（/uploads/xxx 或远程 CDN）
  title      String? // 英文标题
  titleZh    String? // 中文标题
  titleKo    String? // 韩文标题（默认语种）
  subtitle   String?
  subtitleZh String?
  subtitleKo String?
  cta        String? // 按钮文字（英文）
  ctaZh      String?
  ctaKo      String?
  href       String? // CTA 跳转链接
  order      Int      @default(0)
  status     String   @default("published") // published | draft
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([order])
}

// ---------------- SEO / GEO 设置 ----------------

/// 站点级设置（KV 存储，key 唯一）。
/// 用于 SEO 标题/描述/关键词、站长验证码、统计 ID、llms.txt 导语等。
/// 采用 KV 而非固定列：后续新增设置项无需再改表结构。
model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

/// 电子报订阅记录（首页「订阅电子报」区块提交的邮箱）。
model NewsletterSub {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("") // 订阅时所在语种 ko | zh | en
  status    String   @default("active") // active | unsub
  createdAt DateTime @default(now())

  // 统计辅助：避免群发时全表扫描
  @@index([status])
}

/// 电子报群发记录（每次群发一条，便于回溯发过什么、成功率多少）。
/// kind=test 表示只发给了测试邮箱，不计入正式群发。
model NewsletterCampaign {
  id         String   @id @default(cuid())
  subject    String
  body       String
  locale     String   @default("ko") // 该邮件主要语种
  kind       String   @default("broadcast") // broadcast | test
  recipients Int      @default(0) // 目标人数
  sent       Int      @default(0) // 成功数
  failed     Int      @default(0) // 失败数
  dryRun     Boolean  @default(false) // true = 未配 API key，仅日志模式
  errorLog   String   @default("") // 失败明细（最多存 10 条）
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// FAQ 问答（GEO 答案块 + 产品页 FAQPage schema 数据源）。
/// scope=global 为站点级 FAQ；scope=product 时 target 填商品 slug。
/// locale 为空表示适用于全部语种。
model FaqItem {
  id        String   @id @default(cuid())
  scope     String   @default("global") // global | product
  target    String   @default("") // scope=product 时填商品 slug
  question  String
  answer    String
  locale    String   @default("") // '' | ko | zh | en
  order     Int      @default(0)
  status    String   @default("published") // published | draft
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, target])
  @@index([status, order])
}

/// GEO 实体档案：把「品牌是什么 / 卖什么 / 凭什么信」写成结构化事实。
///
/// 为什么需要它（对齐记忆库 GEO 手册）：
///  AI 做实体消歧靠的是**可核对的事实**，而不是形容词堆砌。
///  一条 kind=claim 的事实（如「发货地：韩国」）会被 llms.txt / llms-full.txt /
///  Organization JSON-LD 反复引用，成为「品牌 ↔ 属性」的硬关联。
///  这张表是纯新增，不修改任何既有表与数据。
model GeoFact {
  id        String   @id @default(cuid())
  /// fact | claim | differentiator | audience | shipping | payment | contact
  kind      String   @default("fact")
  /// 事实的键，如「Founded」「Shipping origin」。同 kind 下不重复校验（保持宽容）
  label     String
  /// 事实的值，如「2019」。空则视为草稿，不对外输出
  value     String
  locale    String   @default("") // '' = 全语种通用
  order     Int      @default(0)
  status    String   @default("published") // published | draft
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, order])
  @@index([status])
  @@index([locale])
}

/// Kakao 咨询记录：用户点「Kakao 咨询购买」时留档，
/// 目的是让客服在 Kakao 里收到消息后，能在后台看到对方咨询的是哪个商品/规格/价格。
/// 说明：纯 `<a href>` 跳 Kakao 属于纯跳转，Kakao 侧不传任何商品信息，
/// 所以必须在跳转前由本站写一条记录，否则客服无从得知上下文。
model Consultation {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // 以下为快照字段：商品名/价格/规格日后可能变更，咨询发生时的值需留底
  productName String
  productSlug String?
  skuLabel    String? // 规格摘要，如「색상: 화이트 / 사이즈: M」
  price       Int // 咨询时的单价（KRW）
  locale      String   @default("ko") // 访客所在语言页面
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourcePage  String? // 点击来源页，便于判断是详情页还是购物车
  status      String   @default("new") // new | contacted | closed
  note        String? // 客服备注
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([productId])
}

// ---------------- 站内实时客服（IM） ----------------
/// 客服会话：游客或登录用户与客服之间的对话容器。
/// 未登录访客凭 guestToken（存浏览器 localStorage）继续同一会话，防止串号。
model ChatConversation {
  id          String   @id @default(cuid())
  /// 访客昵称（游客填写；登录用户可空，取账户名）
  visitorName String?
  /// 联系方式类型：email | phone | none
  contactType String   @default("none") // email | phone | none
  /// 联系内容（邮箱或手机号），游客留资用
  contact     String?
  /// 关联登录用户（登录后发起会话时记录，游客为空）
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 游客身份令牌：未登录访客凭此令牌 + conversationId 继续会话与收发消息
  guestToken  String?  @unique
  /// 会话状态：open | closed
  status      String   @default("open")
  /// 访客发起时所在语种（ko | zh | en），便于客服区分
  locale      String   @default("ko")
  /// 最后一条消息时间，列表排序用（必须 Timestamptz，见 ChatMessage.createdAt 注释）
  lastMessageAt DateTime @default(dbgenerated("now()")) @db.Timestamptz(3)
  messages    ChatMessage[]
  createdAt   DateTime @default(dbgenerated("now()")) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, lastMessageAt])
  @@index([userId])
}

/// 客服消息：单条聊天内容（文本或图片）。
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// 发送方：visitor | admin | system
  sender         String // visitor | admin | system
  /// 文本内容（图片消息时可为空，imageUrl 承载）
  content        String?
  /// 图片 URL（OSS 或 /uploads 本地），文本消息为空
  imageUrl       String?
  /// 客户端生成的幂等键：WS 与 REST 兜底重复提交时按此去重，避免重复落库。
  /// 用 DB 级默认值，迁移才能安全加到已有表（Prisma 层默认值会阻止 ALTER）。
  clientId       String           @default(dbgenerated("gen_random_uuid()"))
  /// 单调递增序号：与时区无关的稳定排序键（同一毫秒内的多条消息按此定序）
  seq            Int              @default(autoincrement())
  /// 是否已读（未读 = 对方尚未查看）。用于红点计数
  read           Boolean @default(false)
  /// 必须用 Timestamptz + dbgenerated(now())：
  ///   裸 timestamp 会被 Prisma 与 node-pg 用不同基准解析（差一个时区），导致
  ///   WS 推送与 REST 返回的 createdAt 不一致、消息排序错乱；
  ///   dbgenerated 保证两种写入方（Prisma / 原生 SQL）都用数据库时钟。
  createdAt      DateTime         @default(dbgenerated("now()")) @db.Timestamptz(3)

  @@index([conversationId, createdAt])
  @@index([conversationId, seq])
  @@unique([conversationId, clientId])
}

// Prisma 数据模型 —— 全功能电商
// Prisma 7 范式：url 已移出 schema（见 prisma.config.ts），client 用 adapter 连接
// 生成: npx prisma generate   迁移: npx prisma migrate dev
// 数据库: PostgreSQL（海外部署标准，本地可用 Supabase / Neon / 本机 PG）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------- 用户与地址 ----------------
model User {
  id            String         @id @default(cuid())
  username      String?        @unique // 登录账号（注册时必填，老用户为空则用邮箱登录）
  email         String?        @unique // 选填
  name          String?
  passwordHash  String?
  role          String         @default("customer") // customer | admin
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  cart          Cart?
  consultations Consultation[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String? // 收件人姓名
  line1      String
  line2      String?
  city       String
  state      String?
  country    String
  postalCode String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  orders     Order[]
}

// ---------------- 商品 / 分类 / 品牌 ----------------
model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  nameZh    String? // 多语言预留
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  imageUrl  String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  nameZh   String? // 中文品牌名
  logoUrl  String?
  products Product[]
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  nameZh         String? // 中文商品名（后台双语录入，zh 前台优先显示）
  description    String?
  descriptionZh  String? // 中文描述
  code           String? // 货号 / style code（如 GF410），列表卡小字展示
  gender         String? // men | women | unisex
  brandId        String?
  brand          Brand?         @relation(fields: [brandId], references: [id])
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  price          Int // 基准价（韩元 ₩，整数）
  currency       String         @default("KRW")
  compareAtPrice Int?
  images         String         @default("[]") // JSON 字符串数组
  tags           String         @default("[]") // JSON 字符串数组：new | sale | overseas
  status         String         @default("draft") // draft | active | archived
  rating         Float          @default(0)
  reviewCount    Int            @default(0)
  featured       Boolean        @default(false)
  skus           Sku[]
  specs          ProductSpec[]
  reviews        Review[]
  wishlist       Wishlist[]
  consultations  Consultation[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([gender])
}

// 商品规格组（可多组：颜色 / 尺码 / 材质…），每组含多个规格值，中韩双语
model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // 规格名（韩语/默认），如 색상 / 사이즈
  nameZh    String? // 规格名（中文），如 颜色 / 尺码
  values    String // JSON: [{"ko":"레드","zh":"红色"}, ...]
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, order])
}

model Sku {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuCode   String   @unique
  options   String? // JSON 字符串：{ "Color": "Red", "Size": "M" }
  price     Int?
  stock     Int      @default(0)
  weight    Float?
  createdAt DateTime @default(now())
}

// ---------------- 购物车 ----------------
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  skuId     String?
  quantity  Int     @default(1)

  @@unique([cartId, productId, skuId])
}

// ---------------- 订单 ----------------
model Order {
  id          String      @id @default(cuid())
  orderNo     String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      String      @default("pending") // pending|paid|fulfilled|shipped|completed|cancelled|refunded
  items       OrderItem[]
  subtotal    Int
  discount    Int         @default(0)
  shippingFee Int         @default(0)
  tax         Int         @default(0)
  total       Int
  currency    String      @default("KRW")
  couponCode  String?
  trackingNo  String?
  carrier     String?
  contacted   Boolean     @default(false) // 后台客服是否已联系该订单客户
  contactedAt DateTime?
  addressId   String?
  address     Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shipmentId  String?
  paymentId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  skuId     String?
  name      String
  price     Int
  quantity  Int
  imageUrl  String?
}

// ---------------- 促销 / 评价 / 物流 ----------------
model Coupon {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  code       String    @unique
  type       String // percent | fixed
  value      Int
  minSpend   Int       @default(0)
  productIds String    @default("[]") // JSON 数组：适用商品 id；空=全场通用
  startsAt   DateTime?
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1-5
  title     String?
  content   String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model Shipment {
  id         String    @id @default(cuid())
  orderId    String    @unique
  carrier    String?
  trackingNo String?
  status     String    @default("preparing") // preparing|shipped|delivered
  shippedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ---------------- 收藏 ----------------
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------- 首页轮播图（可后台上传的多图 Banner） ----------------
model EventItem {
  id         String   @id @default(cuid())
  title      String // 标题（韩语，默认语种）
  titleZh    String? // 标题（中文）
  subtitle   String?
  subtitleZh String?
  badge      String? // 角标（如 LIVE / NEW）
  imageUrl   String? // 配图（可选）
  href       String? // 点击跳转
  order      Int      @default(0)
  status     String   @default("published") // published | draft
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, order])
}

model HeroBanner {
  id         String   @id @default(cuid())
  image      String // 图片 URL（/uploads/xxx 或远程 CDN）
  title      String? // 英文标题
  titleZh    String? // 中文标题
  titleKo    String? // 韩文标题（默认语种）
  subtitle   String?
  subtitleZh String?
  subtitleKo String?
  cta        String? // 按钮文字（英文）
  ctaZh      String?
  ctaKo      String?
  href       String? // CTA 跳转链接
  order      Int      @default(0)
  status     String   @default("published") // published | draft
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([order])
}

// ---------------- SEO / GEO 设置 ----------------

/// 站点级设置（KV 存储，key 唯一）。
/// 用于 SEO 标题/描述/关键词、站长验证码、统计 ID、llms.txt 导语等。
/// 采用 KV 而非固定列：后续新增设置项无需再改表结构。
model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

/// 电子报订阅记录（首页「订阅电子报」区块提交的邮箱）。
model NewsletterSub {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("") // 订阅时所在语种 ko | zh | en
  status    String   @default("active") // active | unsub
  createdAt DateTime @default(now())

  // 统计辅助：避免群发时全表扫描
  @@index([status])
}

/// 电子报群发记录（每次群发一条，便于回溯发过什么、成功率多少）。
/// kind=test 表示只发给了测试邮箱，不计入正式群发。
model NewsletterCampaign {
  id         String   @id @default(cuid())
  subject    String
  body       String
  locale     String   @default("ko") // 该邮件主要语种
  kind       String   @default("broadcast") // broadcast | test
  recipients Int      @default(0) // 目标人数
  sent       Int      @default(0) // 成功数
  failed     Int      @default(0) // 失败数
  dryRun     Boolean  @default(false) // true = 未配 API key，仅日志模式
  errorLog   String   @default("") // 失败明细（最多存 10 条）
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// FAQ 问答（GEO 答案块 + 产品页 FAQPage schema 数据源）。
/// scope=global 为站点级 FAQ；scope=product 时 target 填商品 slug。
/// locale 为空表示适用于全部语种。
model FaqItem {
  id        String   @id @default(cuid())
  scope     String   @default("global") // global | product
  target    String   @default("") // scope=product 时填商品 slug
  question  String
  answer    String
  locale    String   @default("") // '' | ko | zh | en
  order     Int      @default(0)
  status    String   @default("published") // published | draft
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, target])
  @@index([status, order])
}

/// GEO 实体档案：把「品牌是什么 / 卖什么 / 凭什么信」写成结构化事实。
///
/// 为什么需要它（对齐记忆库 GEO 手册）：
///  AI 做实体消歧靠的是**可核对的事实**，而不是形容词堆砌。
///  一条 kind=claim 的事实（如「发货地：韩国」）会被 llms.txt / llms-full.txt /
///  Organization JSON-LD 反复引用，成为「品牌 ↔ 属性」的硬关联。
///  这张表是纯新增，不修改任何既有表与数据。
model GeoFact {
  id        String   @id @default(cuid())
  /// fact | claim | differentiator | audience | shipping | payment | contact
  kind      String   @default("fact")
  /// 事实的键，如「Founded」「Shipping origin」。同 kind 下不重复校验（保持宽容）
  label     String
  /// 事实的值，如「2019」。空则视为草稿，不对外输出
  value     String
  locale    String   @default("") // '' = 全语种通用
  order     Int      @default(0)
  status    String   @default("published") // published | draft
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, order])
  @@index([status])
  @@index([locale])
}

/// Kakao 咨询记录：用户点「Kakao 咨询购买」时留档，
/// 目的是让客服在 Kakao 里收到消息后，能在后台看到对方咨询的是哪个商品/规格/价格。
/// 说明：纯 `<a href>` 跳 Kakao 属于纯跳转，Kakao 侧不传任何商品信息，
/// 所以必须在跳转前由本站写一条记录，否则客服无从得知上下文。
model Consultation {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // 以下为快照字段：商品名/价格/规格日后可能变更，咨询发生时的值需留底
  productName String
  productSlug String?
  skuLabel    String? // 规格摘要，如「색상: 화이트 / 사이즈: M」
  price       Int // 咨询时的单价（KRW）
  locale      String   @default("ko") // 访客所在语言页面
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourcePage  String? // 点击来源页，便于判断是详情页还是购物车
  status      String   @default("new") // new | contacted | closed
  note        String? // 客服备注
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([productId])
}
